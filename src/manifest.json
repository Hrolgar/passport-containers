{
  "manifest_version": 2,
  "name": "Passport Containers",
  "version": "0.4.3",
  "description": "Per-URL container rules that follow your Firefox account. Containers are recreated by name on every machine you sign in to.",
  "browser_specific_settings": {
    "gecko": {
      "id": "passport@hrolgar.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "bookmarks",
    "menus",
    "search",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "matcher.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Passport",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://hrolgar.com",
  "omnibox": {
    "keyword": "go"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+P"
      },
      "description": "Open the Passport popup"
    },
    "reopen-next-container": {
      "suggested_key": {
        "default": "Ctrl+Alt+Right"
      },
      "description": "Reopen this tab in the next container"
    },
    "reopen-prev-container": {
      "suggested_key": {
        "default": "Ctrl+Alt+Left"
      },
      "description": "Reopen this tab in the previous container"
    },
    "toggle-pause": {
      "description": "Pause or resume Passport routing"
    }
  }
}
